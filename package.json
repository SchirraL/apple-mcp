{
	"name": "apple-mcp",
	"version": "1.1.0",
	"module": "src/index.ts",
	"type": "module",
	"description": "Apple MCP tools for Reminders, Calendar, Notes, Messages, Contacts, Mail and Maps",
	"author": "Dhravya Shah (original author)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SchirraL/apple-mcp.git"
	},
	"keywords": [
		"mcp",
		"apple",
		"contacts",
		"notes",
		"messages",
		"mail",
		"claude"
	],
	"bin": {
		"apple-mcp": "./dist/index.js"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"service": "bun run scripts/service.ts",
		"build": "bun run scripts/sync-manifest.ts && bun build src/index.ts --outfile=dist/index.js --target=node --minify && bun build src/bridge.ts --outfile=dist/bridge.js --target=node --minify",
		"start": "node dist/index.js",
		"prepublishOnly": "bun run build",
		"test": "bun test tests/unit",
		"typecheck": "tsc --noEmit",
		"inspect": "bunx @modelcontextprotocol/inspector bun run src/index.ts",
		"test:unit": "bun test tests/unit"
	},
	"devDependencies": {
		"@types/bun": "^1.2.0",
		"@types/node": "^22.13.4",
		"typescript": "^5.6.0"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"dependencies": {
		"@jxa/global-type": "^1.3.6",
		"@modelcontextprotocol/sdk": "1.32.1",
		"zod": "^3.24.2",
		"zod-to-json-schema": "^3.24.0"
	},
	"contributors": [
		"Lars Schirra <lars@schirra.io>"
	]
}
